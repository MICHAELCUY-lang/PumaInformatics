# ==============================================================================
# PUMA Informatics — production .env for cPanel (informatics.president.ac.id)
#
# Copy to .env on the server, fill in the blanks, then run:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan db:seed --force
# Never commit the filled-in version: .env is gitignored for a reason.
# ==============================================================================

APP_NAME="PUMA Informatics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://informatics.president.ac.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging — daily rotation so storage/logs cannot fill the hosting quota
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database — created in cPanel > MySQL Databases.
# cPanel prefixes both names with the account user, e.g. pumait_informatics.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Sessions / cache / queue
#
# Shared cPanel accounts usually have no Redis. The database driver is the safe
# default and works everywhere. If your plan does expose Redis, switch the three
# values below to "redis", fill the REDIS_* block, and confirm the phpredis
# extension is enabled in cPanel > Select PHP Version > Extensions.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=informatics.president.ac.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Proxy trust
#
# Leave EMPTY when Apache on cPanel serves the site directly — trusting
# X-Forwarded-For unconditionally would let anyone spoof their IP and defeat the
# vote/aspiration IP hashing plus every rate limiter.
# Set to "*" only if a reverse proxy (campus gateway, Cloudflare) sits in front.
# ------------------------------------------------------------------------------
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Mail — REQUIRED. Email verification gates voting; without working mail nobody
# can cast a ballot. Create the mailbox in cPanel > Email Accounts.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.president.ac.id
MAIL_PORT=465
MAIL_USERNAME=noreply@informatics.president.ac.id
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="noreply@informatics.president.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Media Library — gd ships with virtually every cPanel PHP build.
# Set to imagick only after confirming the extension is enabled.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
MEDIA_DISK=public
IMAGE_DRIVER=gd
QUEUE_CONVERSIONS_BY_DEFAULT=true

# The host disables PHP's symlink(), so `artisan storage:link` can never work
# here. Instead, point the public disk straight at a directory inside the web
# root; uploads then land where Apache can already serve them and the
# APP_URL/storage URLs resolve with no symlink involved.
# Must match the /storage path under the document root.
PUBLIC_DISK_ROOT=/home/infm2327/public_html/storage

# ------------------------------------------------------------------------------
# Bootstrap Super Admin, consumed by AdminUserSeeder.
# Seeding aborts in production if ADMIN_PASSWORD is blank.
# Use a long random password and change it after first login.
# ------------------------------------------------------------------------------
ADMIN_NAME="PUMA IT Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
